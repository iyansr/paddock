// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        // Own user data and extensions, so the debug window does not share settings, groups or
        // the herdr session with an installed Paddock. Its settings.json sets herdrSession to paddock-dev.
        "--user-data-dir=${workspaceFolder}/.vscode-dev/user",
        "--extensions-dir=${workspaceFolder}/.vscode-dev/extensions",
        // Stable VS Code allows the `browser` API proposal only with this flag, even here.
        "--enable-proposed-api=iyansr.paddock"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
