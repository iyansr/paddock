{
  "name": "paddock",
  "displayName": "paddock",
  "description": "Switch projects in one VS Code window without losing your coding agents",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "paddock",
          "title": "Paddock",
          "icon": "media/paddock.svg"
        }
      ]
    },
    "views": {
      "paddock": [
        {
          "id": "paddock.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "paddock.projects",
        "contents": "No projects yet.\n[Add project](command:paddock.addProject)\n[New group](command:paddock.newGroup)"
      }
    ],
    "commands": [
      {
        "command": "paddock.addProject",
        "title": "Add Project",
        "category": "Paddock",
        "icon": "$(add)"
      },
      {
        "command": "paddock.removeProject",
        "title": "Remove Project",
        "category": "Paddock",
        "icon": "$(trash)"
      },
      {
        "command": "paddock.newGroup",
        "title": "New Group",
        "category": "Paddock",
        "icon": "$(new-folder)"
      },
      {
        "command": "paddock.renameGroup",
        "title": "Rename Group",
        "category": "Paddock"
      },
      {
        "command": "paddock.deleteGroup",
        "title": "Delete Group",
        "category": "Paddock"
      },
      {
        "command": "paddock.moveToGroup",
        "title": "Move to Group\u2026",
        "category": "Paddock"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "paddock.addProject",
          "when": "view == paddock.projects",
          "group": "navigation@1"
        },
        {
          "command": "paddock.newGroup",
          "when": "view == paddock.projects",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "submenu": "paddock.projectMenu",
          "when": "view == paddock.projects && viewItem == project",
          "group": "inline"
        },
        {
          "command": "paddock.addProject",
          "when": "view == paddock.projects && viewItem == group",
          "group": "inline"
        },
        {
          "command": "paddock.moveToGroup",
          "when": "view == paddock.projects && viewItem == project",
          "group": "1_organize@1"
        },
        {
          "command": "paddock.removeProject",
          "when": "view == paddock.projects && viewItem == project",
          "group": "9_remove@1"
        },
        {
          "command": "paddock.renameGroup",
          "when": "view == paddock.projects && viewItem == group",
          "group": "1_organize@1"
        },
        {
          "command": "paddock.deleteGroup",
          "when": "view == paddock.projects && viewItem == group",
          "group": "9_remove@1"
        }
      ],
      "commandPalette": [
        {
          "command": "paddock.removeProject",
          "when": "false"
        },
        {
          "command": "paddock.renameGroup",
          "when": "false"
        },
        {
          "command": "paddock.deleteGroup",
          "when": "false"
        },
        {
          "command": "paddock.moveToGroup",
          "when": "false"
        }
      ],
      "paddock.projectMenu": [
        {
          "command": "paddock.moveToGroup",
          "group": "1_organize@1"
        },
        {
          "command": "paddock.removeProject",
          "group": "9_remove@1"
        }
      ]
    },
    "submenus": [
      {
        "id": "paddock.projectMenu",
        "label": "More actions",
        "icon": "$(ellipsis)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit && tsc -p test/unit/tsconfig.json",
    "lint": "eslint src test",
    "test": "vscode-test",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
